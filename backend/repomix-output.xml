INSERT INTO recipes (title,description,instructions,image_url,category,created_by) VALUES
('Ensalada de Remolacha','Remolacha cocida con naranja y queso de cabra.','1. Cocina la remolacha y corta en cubos.\n2. Filetea la naranja.\n3. Coloca rúgula como base.\n4. Agrega remolacha, naranja y queso.\n5. Aliña con vinagre balsámico.','https://picsum.photos/seed/ensaladaremolacha/400/300','Ensaladas',1);
