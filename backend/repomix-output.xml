INSERT INTO recipes (title,description,instructions,image_url,category,created_by) VALUES
('Ensalada de Pollo a la Plancha','Pechuga sobre hojas verdes con aderezo de miel mostaza.','1. Asa el pollo salpimentado.\n2. Mezcla hojas verdes con tomate y pepino.\n3. Prepara aderezo de miel, mostaza y vinagre.\n4. Sirve el pollo rebanado encima.','https://picsum.photos/seed/ensaladapollo/400/300','Ensaladas',1);
